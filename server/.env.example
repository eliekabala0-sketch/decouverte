NODE_ENV=development
PORT=4000
MYSQL_URL=mysql://decouverte:change-me@127.0.0.1:3306/decouverte
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=decouverte-api
APP_ORIGINS=http://localhost:8081,http://localhost:3000
REDIS_URL=redis://127.0.0.1:6379

# Source de migration uniquement. Ne jamais exposer au client.
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres
SUPABASE_URL=https://project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Appels audio/video (LiveKit Cloud ou serveur LiveKit auto-heberge).
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Stockage compatible S3: Cloudflare R2, MinIO, AWS S3, etc.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=decouverte-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
