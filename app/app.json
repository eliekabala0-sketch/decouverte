{
  "expo": {
    "name": "Découverte",
    "slug": "decouverte",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "decouverte",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0F"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.decouverte.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Découverte utilise la caméra pendant vos appels vidéo.",
        "NSMicrophoneUsageDescription": "Découverte utilise le microphone pendant vos appels audio et vidéo."
      }
    },
    "android": {
      "permissions": ["CAMERA", "RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0F"
      },
      "package": "com.decouverte.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-image-picker",
        {
          "photosPermission": "Découverte accède à vos photos pour votre photo de profil.",
          "cameraPermission": "Découverte utilise l’appareil photo pour votre photo de profil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
